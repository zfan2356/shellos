#!/bin/sh
# Remote CLI operations work; opening a local window is now a local action.
set -eu
PIXEL_BIN=${TODE_PIXEL_BIN:-"$HOME/.local/bin/tode-pixel"}
case "${1:-}" in
  --ssh)
    echo "SSH tunneling is disabled; run tode-remote from your Mac." >&2
    exit 2 ;;
  -*) exec "$PIXEL_BIN" "$@" ;;
esac
echo "Open this directory from your Mac: tode-remote <ssh-alias> \"$(pwd)\"" >&2
echo "Remote Kitty control and SSH forwarding are disabled." >&2
exit 2
