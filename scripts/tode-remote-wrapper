#!/bin/sh
# Remote-side `tode`: run code-server remotely and render it in an overlay of
# the current local kitty window. Install with deploy-remote-tode.sh.
set -eu

CONFIG_HOME=${XDG_CONFIG_HOME:-"$HOME/.config"}
CONFIG="$CONFIG_HOME/shellos/remote-tode.env"
[ -r "$CONFIG" ] && . "$CONFIG"

PIXEL_BIN=${TODE_PIXEL_BIN:-"$HOME/.local/bin/tode-pixel"}

pixel() {
  if [ ! -x "$PIXEL_BIN" ]; then
    echo "pixel-mode launcher not found: $PIXEL_BIN" >&2
    exit 1
  fi
  exec "$PIXEL_BIN" "$@"
}

# Flags are commands for tode itself, not project paths. Keep them on the
# remote installation instead of trying to route them through the Mac.
case "${1:-}" in
  -*) pixel "$@" ;;
esac

project=${1:-.}
project=$(cd "$project" 2>/dev/null && pwd) || {
  echo "no such directory: ${1:-.}" >&2
  exit 1
}

if [ -n "${KITTY_LISTEN_ON:-}" ] && command -v kitten >/dev/null 2>&1; then
  if [ -z "${TODE_REMOTE_SSH_HOST:-}" ]; then
    echo "TODE_REMOTE_SSH_HOST is missing from $CONFIG" >&2
    exit 1
  fi
  kitten @ launch --type=overlay-main --self --title "tode $(basename "$project")" \
    /bin/sh -lc 'exec "$HOME/.local/bin/tode" --ssh "$@"' sh \
    "$TODE_REMOTE_SSH_HOST" "$project" >/dev/null \
    && {
      echo "opened locally in the current kitty window: $project"
      exit 0
    }
  echo "kitty remote control failed; falling back to pixel mode" >&2
else
  echo "no forwarded kitty remote control (use kitten ssh); falling back to pixel mode" >&2
fi

pixel "$project"
