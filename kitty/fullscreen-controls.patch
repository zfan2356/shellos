@@ -37,6 +37,31 @@
 #include <float.h>
 #include <string.h>
 #include <assert.h>
+
+#import "shellos_fullscreen_controls.m"
+
+static char shellos_fullscreen_controls_key;
+
+static void
+shellos_remove_fullscreen_controls(_GLFWwindow *window) {
+    ShellOSFullscreenControls *controls = objc_getAssociatedObject(window->ns.object, &shellos_fullscreen_controls_key);
+    [controls invalidate];
+    objc_setAssociatedObject(window->ns.object, &shellos_fullscreen_controls_key, nil, OBJC_ASSOCIATION_RETAIN_NONATOMIC);
+}
+
+static void
+shellos_update_fullscreen_controls(_GLFWwindow *window) {
+    if (!window->ns.in_traditional_fullscreen) {
+        shellos_remove_fullscreen_controls(window);
+    } else if (!objc_getAssociatedObject(window->ns.object, &shellos_fullscreen_controls_key)) {
+        ShellOSFullscreenControls *controls = [[ShellOSFullscreenControls alloc]
+            initWithWindow:window->ns.object closeHandler:^{ _glfwInputWindowCloseRequest(window); }];
+        objc_setAssociatedObject(window->ns.object, &shellos_fullscreen_controls_key, controls, OBJC_ASSOCIATION_RETAIN_NONATOMIC);
+        [controls start];
+        [controls release];
+    }
+}
+

