[
  {
    "key": "ctrl+c",
    "command": "tode.confirmQuit",
    "when": "!terminalFocus && !editorHasSelection && (!inputFocus || editorTextFocus)"
  },
  {
    "key": "cmd+i",
    "command": "chatgpt.addToThread"
  },
  {
    "key": "cmd+t",
    "command": "workbench.action.terminal.newInActiveWorkspace"
  }
]
