{
  "name": "worktree-review",
  "displayName": "Worktree Review",
  "description": "Review the current Git branch against its merge base with a selected base branch.",
  "version": "0.4.4",
  "publisher": "zfan2356",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/zfan2356/shellos.git",
    "directory": "editor/extensions/worktree-review"
  },
  "files": [
    "LICENSE",
    "README.md",
    "resources/**",
    "src/**"
  ],
  "engines": {
    "vscode": "^1.90.0"
  },
  "extensionKind": [
    "workspace"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true,
      "description": "Worktree Review only reads Git metadata and opens local diff views for the current workspace."
    }
  },
  "categories": [
    "Other"
  ],
  "main": "./src/extension.js",
  "activationEvents": [
    "onStartupFinished",
    "onCommand:worktreeReview.resolveExplorerOpen"
  ],
  "contributes": {
    "configuration": {
      "title": "Worktree Review",
      "properties": {
        "worktreeReview.gitPath": {
          "type": "string",
          "default": "git",
          "description": "Path to the Git executable."
        },
        "worktreeReview.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Keep the current branch review open and decorate changed files. Disabling it closes all editors opened by the review and removes branch-relative gutter markers."
        },
        "worktreeReview.diffLayout": {
          "type": "string",
          "enum": [
            "sideBySide",
            "source"
          ],
          "enumDescriptions": [
            "Show the base and current branch in separate columns.",
            "Open the editable current-branch file with gutter change markers."
          ],
          "default": "sideBySide",
          "description": "Presentation used when opening changed files."
        },
        "worktreeReview.branchChanges.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Show cumulative current-branch changes as a read-only Source Control provider."
        },
        "worktreeReview.branchChanges.baseRef": {
          "type": "string",
          "default": "auto",
          "scope": "resource",
          "description": "Base ref whose merge base with HEAD starts the comparison. Auto prefers dev, then origin/dev, the remote default branch, main, or master."
        }
      }
    },
    "commands": [
      {
        "command": "worktreeReview.refreshBranchChanges",
        "title": "Refresh Branch Changes",
        "category": "Worktree Review",
        "icon": "$(refresh)"
      },
      {
        "command": "worktreeReview.selectBranchBaseRef",
        "title": "Select Base Branch",
        "category": "Worktree Review",
        "icon": "$(git-compare)"
      },
      {
        "command": "worktreeReview.useSideBySideDiff",
        "title": "Open Side-by-Side Diff",
        "category": "Worktree Review",
        "icon": "$(split-horizontal)"
      },
      {
        "command": "worktreeReview.useSourceView",
        "title": "Open Source View",
        "category": "Worktree Review",
        "icon": "$(file-code)"
      },
      {
        "command": "worktreeReview.toggleReview",
        "title": "Open/Close Review",
        "category": "Worktree Review",
        "icon": "$(power)"
      },
      {
        "command": "worktreeReview.openCurrentFileReview",
        "title": "Open Current File Review",
        "category": "Worktree Review",
        "icon": "$(diff)"
      },
      {
        "command": "worktreeReview.resolveExplorerOpen",
        "title": "Resolve Explorer Open",
        "category": "Worktree Review"
      }
    ],
    "menus": {
      "scm/title": [
        {
          "command": "worktreeReview.refreshBranchChanges",
          "when": "scmProvider == worktreeReview.branchChanges",
          "group": "navigation@1"
        },
        {
          "command": "worktreeReview.selectBranchBaseRef",
          "when": "scmProvider == worktreeReview.branchChanges",
          "group": "navigation@2"
        }
      ],
      "explorer/context": [
        {
          "command": "worktreeReview.openCurrentFileReview",
          "when": "resourceScheme == file",
          "group": "navigation"
        }
      ],
      "commandPalette": [
        {
          "command": "worktreeReview.refreshBranchChanges",
          "when": "false"
        },
        {
          "command": "worktreeReview.openCurrentFileReview",
          "when": "false"
        },
        {
          "command": "worktreeReview.resolveExplorerOpen",
          "when": "false"
        }
      ]
    }
  },
  "scripts": {
    "lint": "node --check src/extension.js && node --check src/branch-changes.js && node --check src/branch-review-scm.js && node --check src/git-utils.js && node --check test/branch-changes.test.js && node --check test/git-utils.test.js && node --check test/manifest.test.js",
    "test": "node --test test/*.test.js",
    "check": "npm run lint && npm test",
    "package:vsix": "bash scripts/package-vsix.sh"
  },
  "devDependencies": {}
}
