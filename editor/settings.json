  "editor.tokenColorCustomizations": {
    "textMateRules": [
      {
        "scope": [
          "comment",
          "punctuation.definition.comment"
        ],
        "settings": {
          "foreground": "#767a91",
          "fontStyle": "italic"
        }
      },
      {
        "scope": [
          "keyword",
          "storage",
          "storage.type",
          "keyword.control"
        ],
        "settings": {
          "foreground": "#f38ba8"
        }
      },
      {
        "scope": [
          "string",
          "string.quoted",
          "punctuation.definition.string"
        ],
        "settings": {
          "foreground": "#a6e3a1"
        }
      },
      {
        "scope": [
          "constant.numeric",
          "constant.language",
          "constant.character"
        ],
        "settings": {
          "foreground": "#f5c2e7"
        }
      },
      {
        "scope": [
          "entity.name.function",
          "support.function",
          "meta.function-call"
        ],
        "settings": {
          "foreground": "#89b4fa"
        }
      },
      {
        "scope": [
          "entity.name.type",
          "entity.name.class",
          "support.class",
          "support.type"
        ],
        "settings": {
          "foreground": "#f9e2af"
        }
      },
      {
        "scope": [
          "variable",
          "meta.definition.variable.name",
          "variable.other.readwrite"
        ],
        "settings": {
          "foreground": "#cdd6f4"
        }
      },
      {
        "scope": [
          "variable.parameter"
        ],
        "settings": {
          "foreground": "#b1dce5"
        }
      },
      {
        "scope": [
          "entity.name.tag"
        ],
        "settings": {
          "foreground": "#f38ba8"
        }
      },
      {
        "scope": [
          "entity.other.attribute-name"
        ],
        "settings": {
          "foreground": "#f9e2af"
        }
      },
      {
        "scope": [
          "support.type.property-name",
          "meta.object-literal.key"
        ],
        "settings": {
          "foreground": "#94e2d5"
        }
      },
      {
        "scope": [
          "punctuation",
          "meta.brace"
        ],
        "settings": {
          "foreground": "#999fb9"
        }
      },
      {
        "scope": [
          "invalid"
        ],
        "settings": {
          "foreground": "#f38ba8"
        }
      },
      {
        "scope": [
          "markup.heading"
        ],
        "settings": {
          "foreground": "#89b4fa",
          "fontStyle": "bold"
        }
      },
      {
        "scope": [
          "markup.italic"
        ],
        "settings": {
          "fontStyle": "italic"
        }
      },
      {
        "scope": [
          "markup.bold"
        ],
        "settings": {
          "fontStyle": "bold"
        }
      }
    ]
  },
  "python.languageServer": "None",
