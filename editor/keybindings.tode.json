// 
[
  {
    "key": "ctrl+c",
    "command": "tode.confirmQuit",
    "when": "!terminalFocus && !editorHasSelection && (!inputFocus || editorTextFocus)"
  },
  {
    "key": "cmd+i",
    "command": "chatgpt.addToThread"
  },
  {
    "key": "ctrl+t",
    "command": "workbench.action.files.newUntitledFile",
    "when": "!terminalFocus"
  },
  {
    "key": "ctrl+w",
    "command": "workbench.action.closeActiveEditor",
    "when": "!terminalFocus"
  }
]
